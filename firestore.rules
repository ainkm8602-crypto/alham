rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write, list, create, update, delete: if true;
    }
    
    match /products/{id} {
      allow read, write: if true;
    }
    match /users/{id} {
      allow read, write: if true;
    }
    match /orders/{id} {
      allow read, write: if true;
    }
    match /cms/{id} {
      allow read, write: if true;
    }
    match /settings/{id} {
      allow read, write: if true;
    }
    match /media/{id} {
      allow read, write: if true;
    }
    match /media_files/{id} {
      allow read, write: if true;
    }
    match /media_chunks/{id} {
      allow read, write: if true;
    }
    match /ingredients/{id} {
      allow read, write: if true;
    }
    match /articles/{id} {
      allow read, write: if true;
    }
    match /reviews/{id} {
      allow read, write: if true;
    }
    match /coupons/{id} {
      allow read, write: if true;
    }
    match /sections/{id} {
      allow read, write: if true;
    }
  }
}
