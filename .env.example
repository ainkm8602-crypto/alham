# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# RESEND_API_KEY: Required for Resend Email OTP verification delivery.
# Users configure this via environment variables or secret settings.
RESEND_API_KEY=
# RESEND_FROM_EMAIL: The email address to send emails from (must be a verified domain in Resend).
# If not set, defaults to 'onboarding@resend.dev'.
RESEND_FROM_EMAIL=
